# O projeto não tem dependências nem etapa de build: o aplicativo é o arquivo
# geotag_exif_studio.html. Estas regras evitam que arquivos locais entrem no repositório.

# Arquivos exportados pelo aplicativo durante testes locais
geotag_batch_*.zip
geotag_*.jpg
geotag_*.JPG

# Ferramentas opcionais de teste (ex.: Playwright)
node_modules/

# Editores e IDEs
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Sistema operacional
.DS_Store
Thumbs.db
desktop.ini

# Arquivos temporários
*.tmp
*.bak
*.log
scratch/
